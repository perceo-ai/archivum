FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY pyproject.toml .
RUN uv sync --no-dev

COPY archivum/ archivum/

# Run as non-root
RUN useradd -m -u 10001 app \
  && chown -R app:app /app

EXPOSE 8001

USER app

CMD ["uv", "run", "python", "-m", "archivum.mcp.server", "--sse"]

# Archivum Configuration
# Copy to .env and fill in your values

# ─── Required ────────────────────────────────────────────────────────────────

# Anthropic API key — get one at console.anthropic.com
ANTHROPIC_API_KEY=change-me

# OpenRouter API key — get one at openrouter.ai
# OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Owner password (plaintext — hashed on first boot, then this value is ignored)
OWNER_PASSWORD=change-me-min-12-chars

# Owner username (used to log in first)
OWNER_USERNAME=admin

# API key for MCP clients (separate from JWT — used by Claude Code, Cursor, etc.)
# Generate with: openssl rand -hex 24
MCP_API_KEY=change-me-generate-with-openssl-rand-hex-24

# ─── Optional ────────────────────────────────────────────────────────────────

# Public hostname for Caddy TLS (leave empty for localhost-only with self-signed)
# ARCHIVUM_HOST=archivum.example.com

# Local-only host port for accessing the frontend container directly.
# ARCHIVUM_FRONTEND_PORT=8473

# Local-only host port for MCP clients.
# ARCHIVUM_MCP_PORT=8001

# Published image source used by the installer / docker-compose.images.yml.
# ARCHIVUM_IMAGE_REGISTRY=ghcr.io/pranavkannepalli
# ARCHIVUM_IMAGE_TAG=latest

# Expose the full wiki as read-only at /public and /api/public/pages.
# Token share links work independently of this setting.
# PUBLIC_WIKI_ENABLED=false

# Ollama endpoint (used when choosing provider=ollama for LLM or embeddings)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional bearer token for hosted Ollama/OpenAI-compatible proxies.
# OLLAMA_API_KEY=change-me

# Embeddings provider:
# - local: fastembed runs in the backend container (default)
# - openai_compat: any OpenAI-compatible embeddings API (OpenAI, Together, Fireworks, etc.)
# - openrouter: use OpenRouter's OpenAI-compatible endpoint
# - ollama: use local Ollama OpenAI-compat endpoint at ${OLLAMA_BASE_URL}/v1
EMBED_PROVIDER=local

# Embedding model (local model id, OpenAI model id, or Azure deployment name)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Embedding dimension (MUST match the provider's actual output dim, because Qdrant
# collections have a fixed vector size). Set to 0 to auto-detect from the provider/model.
EMBED_DIM=0

# For EMBED_PROVIDER=openai_compat
# EMBED_OPENAI_COMPAT_PROVIDER=openai   # openai|together|fireworks|groq|deepinfra|azure|custom
# EMBED_BASE_URL=                       # only for azure/custom overrides
# EMBED_API_KEY=change-me

# Azure OpenAI (optional when using an Azure base URL)
# EMBED_AZURE_API_VERSION=2024-02-15-preview

# If you change EMBED_DIM, Archivum can optionally recreate the Qdrant
# collection automatically (this will clear existing vectors).
# QDRANT_RECREATE_COLLECTION_ON_DIM_MISMATCH=false

# Split LLM provider by pipeline stage:
# - extraction: entities + relationships (wiki agent)
# - synthesis: question answering + citations
LLM_EXTRACTION_PROVIDER=anthropic
LLM_SYNTHESIS_PROVIDER=anthropic

# LLM models
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_SYNTHESIS_MODEL=claude-sonnet-4-6

# If you set LLM_*_PROVIDER=openrouter, set these to OpenRouter model IDs
# (e.g. openrouter/auto, openai/gpt-4o-mini, etc.).

# Generic OpenAI-compatible LLM provider (OpenAI, Together, Fireworks, etc.)
# LLM_EXTRACTION_PROVIDER=openai_compat
# LLM_SYNTHESIS_PROVIDER=openai_compat
# OPENAI_COMPAT_PROVIDER=openai        # openai|together|fireworks|groq|deepinfra|azure|custom
# OPENAI_COMPAT_BASE_URL=              # only for azure/custom overrides
# OPENAI_COMPAT_API_KEY=change-me
# OPENAI_COMPAT_AZURE_API_VERSION=2024-02-15-preview

# Max files per batch ingest
# MAX_BATCH_SIZE=20

# Logging
# LOG_LEVEL=INFO   # DEBUG|INFO|WARNING|ERROR

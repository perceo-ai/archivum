FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock .
RUN uv sync --no-dev --frozen --no-cache

COPY archivum/ archivum/

# Run as non-root
RUN useradd -m -u 10001 app

# Same as the API image: `.cache` is a named volume at run time holding the
# embedding model, and a fresh volume takes the ownership of the path it
# covers. Root-owned, the warmup cannot write it.
RUN mkdir -p /home/app/.cache/fastembed && chown -R app:app /home/app/.cache

EXPOSE 8001

USER app

CMD ["python", "-m", "archivum.mcp.server", "--sse"]

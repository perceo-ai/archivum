{"nodes": [{"id": "archivum_prd_v1_0_archivum", "label": "Archivum", "file_type": "document", "source_file": "archivum-prd-v1.0.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"taglines": ["Your knowledge base, compiled.", "The wiki that writes itself.", "Knowledge that compounds."], "domain_v1": "archivum.madebypranav.dev", "domain_public": "archivumapp.com", "github_org": "github.com/archivum", "docker_image": "archivumapp/archivum", "deployment": "self-hosted, Docker Compose, home server", "version": "1.0", "status": "Draft", "timeline": "1 week build", "rationale": "Archivum fills the gap between manual wikis (which require constant bookkeeping and rot) and LLM retrieval tools (which treat every query as a clean slate and accumulate nothing). An AI agent incrementally builds and maintains a persistent wiki so knowledge compounds with every source added and every question asked. Latin root 'archive' chosen for global recognisability, distinctiveness in PKM/dev tools space, and scalability from personal tool to product brand."}}, {"id": "archivum_prd_v1_0_ingest_pipeline", "label": "Ingest Pipeline", "file_type": "document", "source_file": "archivum-prd-v1.0.md", "source_location": "\u00a76 Epic 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"flow": "file lands in /raw \u2192 parser extracts text + metadata \u2192 LLM processes into wiki pages \u2192 Qdrant + Neo4j updated", "batch_limit": "up to 20 files per drag-drop", "processing": "sequential (not parallel) to avoid LLM rate limits", "rationale": "Sequential processing avoids LLM rate limits. /raw is write-once \u2014 files are never modified after ingest, protecting source integrity."}}, {"id": "archivum_prd_v1_0_wiki_agent", "label": "Wiki Agent", "file_type": "document", "source_file": "archivum-prd-v1.0.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, 